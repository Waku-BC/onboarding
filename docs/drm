        </div>
      </div>
    </section>

    <section class="panel" style="margin-top:20px;">
      <div class="panel-head">
        <div>
          <h2 class="panel-title">Network-ish Log</h2>
          <p class="panel-sub">Detailed events stay here instead of cluttering the headline summary.</p>
        </div>
        <div class="panel-badge">devtools-inspired</div>
      </div>
      <div class="panel-body">
        <div class="log" id="networkLog" aria-live="polite"></div>
      </div>
    </section>
  </div>

  <script>
    (function(){
      const app = {
        state: {
          currentScriptEl: null,
          currentPlayerId: 'bcInspectorPlayer',
          encryptedSeen: false,
          playingSeen: false,
          manifestDrmSeen: false,
          licenseSeen: false,
          drmSystem: null,
          licenseStatusText: null,
          playerReadySeen: false,
          playerPoll: null,
          lastLatencyMs: null
        },
        refs: {
          accountId: document.getElementById('accountId'),
          playerId: document.getElementById('playerId'),
          videoId: document.getElementById('videoId'),
          runBtn: document.getElementById('runBtn'),
          clearBtn: document.getElementById('clearBtn'),
          playerContainer: document.getElementById('playerContainer'),
          networkLog: document.getElementById('networkLog'),
          scriptUrlValue: document.getElementById('scriptUrlValue'),
          playerUrlValue: document.getElementById('playerUrlValue'),
          pageContextValue: document.getElementById('pageContextValue'),
          playerStatusValue: document.getElementById('playerStatusValue'),
          metricDrmSignal: document.getElementById('metricDrmSignal'),
          hintDrmSignal: document.getElementById('hintDrmSignal'),
          metricDrmSystem: document.getElementById('metricDrmSystem'),
          hintDrmSystem: document.getElementById('hintDrmSystem'),
          metricLicense: document.getElementById('metricLicense'),
          hintLicense: document.getElementById('hintLicense'),
          metricLatency: document.getElementById('metricLatency'),
          hintLatency: document.getElementById('hintLatency'),
          metricProtectedPlayback: document.getElementById('metricProtectedPlayback'),
          hintProtectedPlayback: document.getElementById('hintProtectedPlayback')
        }
      };

      const licenseRegex = /(\/license\/|license(?=\/|\?|$)|widevine|fairplay|playready|\/fps\/|\/cenc\/|drm)/i;
      const manifestRegex = /(\.m3u8(\?|$)|\.mpd(\?|$)|master\.m3u8|manifest)/i;

      function now() {
        const d = new Date();
        return d.toLocaleTimeString([], {hour12:false});
      }
      function escapeHtml(s){
        return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
      }
      function log(message, tone='info') {
        const row = document.createElement('div');
        row.className = 'log-row';
        row.innerHTML = '<span class="tag '+tone+'">'+tone+'</span>['+now()+'] '+escapeHtml(message);
        app.refs.networkLog.prepend(row);
      }
      function setMetric(el, value, cls) {
        el.textContent = value;
        el.className = 'v ' + (cls || 'status-plain');
      }
      function setHint(el, text) { el.textContent = text; }
      function setPlayerStatus(text) { app.refs.playerStatusValue.textContent = text; }

      function resetSummary() {
        app.state.encryptedSeen = false;
        app.state.playingSeen = false;
        app.state.manifestDrmSeen = false;
        app.state.licenseSeen = false;
        app.state.drmSystem = null;
        app.state.licenseStatusText = null;
        app.state.playerReadySeen = false;
        app.state.lastLatencyMs = null;

        setMetric(app.refs.metricDrmSignal, 'Not observed', 'status-plain');
        setHint(app.refs.hintDrmSignal, 'No DRM signal observed yet.');
        setMetric(app.refs.metricDrmSystem, 'Unknown', 'status-plain');
        setHint(app.refs.hintDrmSystem, 'Widevine, FairPlay, or PlayReady will appear here when detected.');
        setMetric(app.refs.metricLicense, 'Not observed', 'status-plain');
        setHint(app.refs.hintLicense, 'A real DRM license request usually appears after playback begins.');
        setMetric(app.refs.metricLatency, 'Unknown', 'status-plain');
        setHint(app.refs.hintLatency, 'Shown when a DRM-style license request/response is observed.');
        setMetric(app.refs.metricProtectedPlayback, 'Unknown', 'status-plain');
        setHint(app.refs.hintProtectedPlayback, 'Best signal: encrypted event or confirmed key/license flow plus playback.');
      }

      function clearPlayerDom() {
        if (app.state.playerPoll) {
          clearInterval(app.state.playerPoll);
          app.state.playerPoll = null;
        }
        app.refs.playerContainer.innerHTML = '<div class="placeholder">Player slot is waiting for input.<br />Enter Account ID, Player ID, and Video ID, then click <strong>Run Inspector</strong>.</div>';
        if (app.state.currentScriptEl && app.state.currentScriptEl.parentNode) {
          app.state.currentScriptEl.parentNode.removeChild(app.state.currentScriptEl);
        }
        app.state.currentScriptEl = null;
      }

      function fullScriptUrl(account, player) {
        return 'https://players.brightcove.net/' + account + '/' + player + '_default/index.min.js';
      }
      function fullPlayerUrl(account, player, video) {
        return 'https://players.brightcove.net/' + account + '/' + player + '_default/index.html?videoId=' + encodeURIComponent(video);
      }

      function detectDrmSystemFromText(text) {
        const lower = String(text || '').toLowerCase();
        if (lower.includes('widevine')) return 'Widevine';
        if (lower.includes('fairplay') || lower.includes('skd://') || lower.includes('com.apple.fps')) return 'FairPlay';
        if (lower.includes('playready')) return 'PlayReady';
        return null;
      }

      function latencyTone(ms) {
        if (ms == null) return ['Unknown', 'status-plain'];
        if (ms < 150) return [ms + ' ms', 'status-good'];
        if (ms < 500) return [ms + ' ms', 'status-warn'];
        return [ms + ' ms', 'status-bad'];
      }
      function latencyHint(ms) {
        if (ms == null) return 'Shown when a DRM-style license request/response is observed.';
        if (ms < 150) return 'Low latency. License exchange is unlikely to be the main startup bottleneck.';
        if (ms < 500) return 'Moderate latency. This can contribute to slower playback startup.';
        return 'High latency. A slow license exchange may delay startup or cause failures under load.';
      }

      function updateSummaryFromState() {
        if (app.state.manifestDrmSeen) {
          setMetric(app.refs.metricDrmSignal, 'Detected', 'status-good');
          setHint(app.refs.hintDrmSignal, 'Manifest or DRM-specific traffic indicates that the stream is configured for protected playback.');
        } else {
          setMetric(app.refs.metricDrmSignal, 'Not observed', 'status-plain');
          setHint(app.refs.hintDrmSignal, 'No manifest-level DRM signal has been confirmed yet.');
        }

        if (app.state.drmSystem) {
          setMetric(app.refs.metricDrmSystem, app.state.drmSystem, 'status-info');
          setHint(app.refs.hintDrmSystem, 'Detected from manifest content or DRM-related endpoint naming.');
        } else {
          setMetric(app.refs.metricDrmSystem, 'Unknown', 'status-plain');
          setHint(app.refs.hintDrmSystem, 'No key system has been confidently identified yet.');
        }

        if (app.state.licenseSeen && app.state.licenseStatusText) {
          setMetric(app.refs.metricLicense, app.state.licenseStatusText, 'status-good');
          setHint(app.refs.hintLicense, 'A DRM-style license request/response was observed after playback startup activity.');
        } else if (app.state.licenseSeen) {
          setMetric(app.refs.metricLicense, 'Observed', 'status-good');
          setHint(app.refs.hintLicense, 'A DRM-style license request was observed, but the exact response state is limited by browser visibility.');
        } else {
          setMetric(app.refs.metricLicense, 'Not observed', 'status-plain');
          setHint(app.refs.hintLicense, 'No DRM-style license request has been confirmed yet.');
        }

        const lat = latencyTone(app.state.lastLatencyMs);
        setMetric(app.refs.metricLatency, lat[0], lat[1]);
        setHint(app.refs.hintLatency, latencyHint(app.state.lastLatencyMs));

        if (app.state.encryptedSeen && app.state.playingSeen) {
          setMetric(app.refs.metricProtectedPlayback, 'Confirmed', 'status-good');
          setHint(app.refs.hintProtectedPlayback, 'Encrypted media event plus active playback is the strongest signal available in-page.');
        } else if (app.state.licenseSeen && app.state.playingSeen) {
          setMetric(app.refs.metricProtectedPlayback, 'Likely', 'status-warn');
          setHint(app.refs.hintProtectedPlayback, 'Playback is active and a DRM-style license flow was observed.');
        } else if (app.state.playingSeen) {
          setMetric(app.refs.metricProtectedPlayback, 'Playing', 'status-info');
          setHint(app.refs.hintProtectedPlayback, 'Playback started, but protected playback has not been fully confirmed.');
        } else {
          setMetric(app.refs.metricProtectedPlayback, 'Unknown', 'status-plain');
          setHint(app.refs.hintProtectedPlayback, 'Waiting for playback or DRM lifecycle signals.');
        }
      }

      function observeManifestBody(url, bodyText) {
        const detectedSystem = detectDrmSystemFromText(bodyText);
        const lower = String(bodyText || '').toLowerCase();
        if (lower.includes('#ext-x-key') || lower.includes('contentprotection') || detectedSystem) {
          if (!app.state.manifestDrmSeen) log('Manifest DRM signal detected in ' + url, 'good');
          app.state.manifestDrmSeen = true;
        }
        if (detectedSystem && app.state.drmSystem !== detectedSystem) {
          app.state.drmSystem = detectedSystem;
          log('DRM system detected from manifest: ' + detectedSystem, 'good');
        }
        updateSummaryFromState();
      }

      async function inspectFetchResponse(url, response, startedAt) {
        const elapsed = Date.now() - startedAt;
        const statusText = response ? String(response.status) : 'unknown';
        if (licenseRegex.test(url)) {
          app.state.licenseSeen = true;
          app.state.lastLatencyMs = elapsed;
          const sys = detectDrmSystemFromText(url);
          if (sys && !app.state.drmSystem) app.state.drmSystem = sys;
          app.state.licenseStatusText = response ? ('HTTP ' + statusText) : 'Observed';
          app.state.manifestDrmSeen = true;
          log('License fetch ' + statusText + ' - ' + truncate(url) + ' - ' + elapsed + ' ms', response && response.ok ? 'good' : 'warn');
          updateSummaryFromState();
          return;
        }
        if (manifestRegex.test(url)) {
          log('Manifest fetch ' + statusText + ' - ' + truncate(url) + ' - ' + elapsed + ' ms', 'info');
          try {
            const clone = response.clone();
            const text = await clone.text();
            observeManifestBody(url, text);
          } catch (_) {}
          return;
        }
        if (/\.(m4s|m4f|ts|cmf|mp4)(\?|$)/i.test(url)) {
          log('Segment fetch - ' + truncate(url), 'info');
        }
      }

      function truncate(url) {
        if (url.length <= 118) return url;
        return url.slice(0, 86) + ' … ' + url.slice(-24);
      }

      function installNetworkHooks() {
        if (window.__bcInspectorHooksInstalled) return;
        window.__bcInspectorHooksInstalled = true;

        const originalFetch = window.fetch.bind(window);
        window.fetch = async function(...args) {
          const requestUrl = typeof args[0] === 'string' ? args[0] : (args[0] && args[0].url ? args[0].url : '');
          const startedAt = Date.now();
          try {
            const response = await originalFetch(...args);
            if (requestUrl) inspectFetchResponse(requestUrl, response, startedAt);
            return response;
          } catch (error) {
            if (requestUrl && licenseRegex.test(requestUrl)) {
              app.state.licenseSeen = true;
              app.state.manifestDrmSeen = true;
              app.state.licenseStatusText = 'Error';
              app.state.lastLatencyMs = Date.now() - startedAt;
              updateSummaryFromState();
              log('License fetch failed - ' + truncate(requestUrl), 'bad');
            } else if (requestUrl) {
              log('Fetch failed - ' + truncate(requestUrl), 'bad');
            }
            throw error;
          }
        };

        const OriginalXHR = window.XMLHttpRequest;
        function WrappedXHR() {
          const xhr = new OriginalXHR();
          let method = 'GET';
          let url = '';
          let startedAt = 0;
          const open = xhr.open;
          xhr.open = function(m, u, ...rest) {
            method = String(m || 'GET').toUpperCase();
            url = u || '';
            return open.call(xhr, m, u, ...rest);
          };
          const send = xhr.send;
          xhr.send = function(...rest) {
            startedAt = Date.now();
            xhr.addEventListener('loadend', function() {
              const elapsed = Date.now() - startedAt;
              if (!url) return;
              if (licenseRegex.test(url)) {
                app.state.licenseSeen = true;
                app.state.manifestDrmSeen = true;
                app.state.lastLatencyMs = elapsed;
                const sys = detectDrmSystemFromText(url);
                if (sys && !app.state.drmSystem) app.state.drmSystem = sys;
                app.state.licenseStatusText = 'HTTP ' + xhr.status;
                updateSummaryFromState();
                log('License XHR ' + xhr.status + ' - ' + truncate(url) + ' - ' + elapsed + ' ms', xhr.status >= 200 && xhr.status < 300 ? 'good' : 'warn');
              } else if (manifestRegex.test(url)) {
                log('Manifest XHR ' + xhr.status + ' - ' + truncate(url) + ' - ' + elapsed + ' ms', 'info');
                try {
                  const text = typeof xhr.responseText === 'string' ? xhr.responseText : '';
                  if (text) observeManifestBody(url, text);
                } catch (_) {}
              } else if (/\.(m4s|m4f|ts|cmf|mp4)(\?|$)/i.test(url)) {
                log(method + ' segment - ' + truncate(url), 'info');
              }
            });
            return send.apply(xhr, rest);
          };
          return xhr;
        }
        window.XMLHttpRequest = WrappedXHR;
      }

      function wirePlayerLifecycle(player) {
        player.ready(function(){
          app.state.playerReadySeen = true;
          setPlayerStatus('Ready');
          log('Player ready', 'good');
          player.on('play', function(){ log('Play requested', 'info'); });
          player.on('playing', function(){
            app.state.playingSeen = true;
            setPlayerStatus('Playing');
            log('Playback started', 'good');
            updateSummaryFromState();
          });
          player.on('error', function(){
            const err = player.error && player.error();
            setPlayerStatus('Error');
            log('Player error: ' + (err && err.message ? err.message : 'unknown error'), 'bad');
          });
          try {
            const tech = player.tech(true);
            const techEl = tech && tech.el ? tech.el() : null;
            if (techEl) {
              techEl.addEventListener('encrypted', function(){
                app.state.encryptedSeen = true;
                app.state.manifestDrmSeen = true;
                log('EME encrypted event detected', 'good');
                updateSummaryFromState();
              }, { passive:true });
              techEl.addEventListener('waiting', function(){ log('Playback waiting/buffering', 'warn'); }, { passive:true });
            }
          } catch (_) {
            log('Could not attach directly to tech element for EME inspection', 'warn');
          }
        });
      }

      function waitForPlayerAndInit() {
        let attempts = 0;
        app.state.playerPoll = setInterval(function(){
          attempts += 1;
          const hasVideoJs = typeof window.videojs === 'function';
          const player = hasVideoJs ? window.videojs.getPlayer(app.state.currentPlayerId) : null;
          if (player) {
            clearInterval(app.state.playerPoll);
            app.state.playerPoll = null;
            wirePlayerLifecycle(player);
            return;
          }
          if (attempts > 80) {
            clearInterval(app.state.playerPoll);
            app.state.playerPoll = null;
            setPlayerStatus('Load timeout');
            log('Timed out waiting for Brightcove player runtime', 'bad');
          }
        }, 250);
      }

      function loadPlayer() {
        const account = app.refs.accountId.value.trim();
        const player = app.refs.playerId.value.trim();
        const video = app.refs.videoId.value.trim();
        if (!account || !player || !video) {
          log('Please fill Account ID, Player ID, and Video ID before running the inspector.', 'warn');
          return;
        }

        resetSummary();
        app.refs.networkLog.innerHTML = '';
        clearPlayerDom();

        const scriptUrl = fullScriptUrl(account, player);
        const playerUrl = fullPlayerUrl(account, player, video);

        app.refs.scriptUrlValue.textContent = scriptUrl;
        app.refs.playerUrlValue.textContent = playerUrl;
        app.refs.pageContextValue.textContent = window.location.href;
        setPlayerStatus('Loading');
        log('Starting dynamic Brightcove player load', 'info');
        log('Account=' + account + ' Player=' + player + ' Video=' + video, 'info');

        const videoTag = document.createElement('video-js');
        videoTag.id = app.state.currentPlayerId;
        videoTag.className = 'video-js';
        videoTag.setAttribute('data-account', account);
        videoTag.setAttribute('data-player', player);
        videoTag.setAttribute('data-embed', 'default');
        videoTag.setAttribute('data-video-id', video);
        videoTag.setAttribute('controls', '');
        videoTag.setAttribute('playsinline', '');
        videoTag.setAttribute('preload', 'auto');

        app.refs.playerContainer.innerHTML = '';
        app.refs.playerContainer.appendChild(videoTag);

        const script = document.createElement('script');
        script.src = scriptUrl;
        script.async = true;
        script.onload = function(){
          log('Player runtime script loaded', 'good');
          waitForPlayerAndInit();
        };
        script.onerror = function(){
          setPlayerStatus('Script load error');
          log('Failed to load Brightcove player runtime script', 'bad');
        };
        document.body.appendChild(script);
        app.state.currentScriptEl = script;
      }

      function clearAll() {
        clearPlayerDom();
        app.refs.networkLog.innerHTML = '';
        resetSummary();
        app.refs.scriptUrlValue.textContent = 'Not loaded yet';
        app.refs.playerUrlValue.textContent = 'Not loaded yet';
        app.refs.pageContextValue.textContent = 'Waiting for player load';
        setPlayerStatus('Idle');
      }

      app.refs.runBtn.addEventListener('click', loadPlayer);
      app.refs.clearBtn.addEventListener('click', clearAll);
      installNetworkHooks();
      resetSummary();
      app.refs.pageContextValue.textContent = window.location.href;
    })();
  </script>
</body>
</html>
